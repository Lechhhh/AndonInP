# Start lokalny: npm start -> http://localhost:3000
NODE_ENV=development
PORT=3000
ANDON_HOST=127.0.0.1
ANDON_PANEL_PATH=/panelsterowania
ANDON_SHOW_PANEL_LINK=true
# Pusty webhook wyłącza wysyłkę zewnętrzną; zgłoszenia pozostają lokalnie.
DISCORD_WEBHOOK_URL=

# Produkcja: ustaw NODE_ENV=production i rzeczywiste wartości uzgodnione z IT.
# Hosting Render: konfiguracja zmiennych, proxy i trwałego dysku w RENDER.md.
# Publiczne testy z dowolnego IP: true i puste ANDON_ALLOWED_CLIENTS.
# Nie wyłącza wymagań HTTPS, proxy, klucza ani logowania.
ANDON_PUBLIC_TEST_MODE=false
# ANDON_ALLOWED_ORIGINS=https://andon.inpost.pl
# ANDON_ALLOWED_CLIENTS=10.20.30.0/24
# ANDON_MASTER_KEY_FILE=C:/ProgramData/AndonKeys/master.key
# ANDON_DATA_DIR=C:/ProgramData/AndonData
# ANDON_STATE_FILE=C:/ProgramData/AndonData/andon_state.json
# ANDON_LOG_DIR=C:/ProgramData/AndonData/logs

# Wariant A: reverse proxy HTTPS na tym samym serwerze, port Node dostępny tylko lokalnie.
# ANDON_TRUST_PROXY=127.0.0.1/32,::1/128
# Proxy musi nadpisywać X-Forwarded-For i X-Forwarded-Proto oraz obsługiwać WebSocket.

# Wariant B: bezpośredni HTTPS w Node (wtedy usuń ANDON_TRUST_PROXY).
# ANDON_HOST=0.0.0.0
# ANDON_TLS_CERT_FILE=C:/ProgramData/AndonTLS/fullchain.pem
# ANDON_TLS_KEY_FILE=C:/ProgramData/AndonTLS/private.key
